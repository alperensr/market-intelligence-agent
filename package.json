{
  "name": "market-intelligence-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal TypeScript foundation for a market intelligence agent.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:server": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "dev:web": "vite web",
    "build:web": "vite build web",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
